# ====================================================================
# ASP.NET Core / .NET 10 GitIgnore
# ====================================================================

# Carpetas de compilación e intermediate output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Archivos de usuario y configuración local de Visual Studio / Rider
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.idea/
*.userprefs

# Archivos de publicación (Publish)
*.publish.htm
*.azurepubxml
pub/
Publish/
obj/Release/

# Secretos y configuraciones locales (¡CRÍTICO no subir esto!)
appsettings.Development.json
appsettings.Local.json
*.secrets.json
.env.development.local
.env.local
.env.production.local
.env.test.local

# Respaldos de EF Core y archivos de base de datos locales
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Archivos temporales de pruebas y cobertura de código
TestResults/
*.clog
.attachments/

# Crash dumps
*.dmp
*.mdmp

# ====================================================================
# React / Node / Frontend GitIgnore
# ====================================================================

# Dependencias de Node
node_modules/
jspm_packages/

# Carpetas de producción / compilación del Frontend
dist/
build/
out/
.next/

# Logs de error de npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de entorno de Vite / React
.env
.env.production
.env.development

# Caché de herramientas de Frontend
.eslintcache
.stylelintcache
.cache/
.parcel-cache

# ====================================================================
# Sistema Operativo / Generales
# ====================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Archivos temporales de editores de texto
*~
*.swp
*.bak
